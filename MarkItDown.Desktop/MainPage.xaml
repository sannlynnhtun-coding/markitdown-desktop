<Page
    x:Class="MarkItDown.Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MarkItDown.Desktop.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnLoaded">

  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAccelerator" />
    <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnConvertAccelerator" />
    <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveAccelerator" />
    <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="OnSaveAsAccelerator" />
  </Page.KeyboardAccelerators>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" AutomationProperties.Name="Document conversion commands">
      <AppBarButton Icon="OpenFile" Label="Add files" ToolTipService.ToolTip="Add files (Ctrl+O)" AutomationProperties.Name="Add files" Click="OnAddFilesClick" />
      <AppBarButton Icon="Play" Label="Convert all" IsEnabled="{Binding CanConvert}" ToolTipService.ToolTip="Convert pending files (Ctrl+Enter)" AutomationProperties.Name="Convert all pending files" Click="OnConvertAllClick" />
      <AppBarButton Icon="Stop" Label="Cancel" IsEnabled="{Binding IsBusy}" ToolTipService.ToolTip="Cancel the current batch" AutomationProperties.Name="Cancel batch conversion" Click="OnCancelClick" />
      <AppBarSeparator />
      <AppBarButton Icon="Save" Label="Save" IsEnabled="{Binding CanSaveSelected}" ToolTipService.ToolTip="Save changes (Ctrl+S)" AutomationProperties.Name="Save Markdown changes" Click="OnSaveClick" />
      <AppBarButton Icon="SaveLocal" Label="Save as" IsEnabled="{Binding HasSelection}" ToolTipService.ToolTip="Save a copy (Ctrl+Shift+S)" AutomationProperties.Name="Save Markdown as a new file" Click="OnSaveAsClick" />
      <AppBarButton Icon="Folder" Label="Open folder" ToolTipService.ToolTip="Open the output folder" AutomationProperties.Name="Open output folder" Click="OnOpenOutputFolderClick" />
      <CommandBar.SecondaryCommands>
        <AppBarButton Label="Clear finished" IsEnabled="{Binding CanClearFinished}" AutomationProperties.Name="Remove completed, failed, and canceled items" Click="OnClearFinishedClick" />
      </CommandBar.SecondaryCommands>
    </CommandBar>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Padding="16,10" ColumnSpacing="12">
      <TextBlock Grid.Column="0" Text="Output folder" VerticalAlignment="Center" FontWeight="SemiBold" />
      <TextBox x:Name="OutputFolderTextBox" Grid.Column="1" Text="{Binding OutputFolder}" IsReadOnly="True" AutomationProperties.Name="Current output folder" />
      <Button Grid.Column="2" Content="Choose…" AutomationProperties.Name="Choose output folder" Click="OnChooseOutputFolderClick" />
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="360,*" Padding="16,0,16,12" ColumnSpacing="16">
      <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
          <Grid
              x:Name="DropZone"
              Grid.Row="0"
              MinHeight="92"
              Padding="16"
              AllowDrop="True"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              DragOver="OnDropZoneDragOver"
              Drop="OnDropZoneDrop"
              AutomationProperties.Name="File drop area. Use Add files as a keyboard alternative.">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
              <FontIcon Glyph="&#xE898;" FontSize="24" AutomationProperties.AccessibilityView="Raw" />
              <TextBlock Text="Drop files here" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="or use Add files" Opacity="0.72" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>

          <ListView
              x:Name="QueueList"
              Grid.Row="1"
              ItemsSource="{Binding Jobs}"
              SelectionMode="Single"
              SelectionChanged="OnQueueSelectionChanged"
              AutomationProperties.Name="Conversion queue">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:ConversionJob">
                <Grid Padding="8" RowDefinitions="Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1" Text="{x:Bind StatusText, Mode=OneWay}" Opacity="0.78" />
                  <TextBlock Grid.Row="2" Text="{x:Bind ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>

      <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid Grid.Row="0" Padding="20,16,20,8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="3">
              <TextBlock Text="{Binding SelectedJob.FileName}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding SelectedJob.OutputPath}" Opacity="0.72" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding SelectedJob.StatusText}" VerticalAlignment="Center" />
              <Button Content="Retry / reconvert" IsEnabled="{Binding CanRetrySelected}" AutomationProperties.Name="Retry or reconvert selected file" Click="OnRetryClick" />
            </StackPanel>
          </Grid>

          <InfoBar x:Name="DocumentInfoBar" Grid.Row="1" Margin="16,4" IsClosable="False" IsOpen="False">
            <InfoBar.ActionButton>
              <Button
                  x:Name="OpenFullOutputButton"
                  Content="Open full file"
                  Visibility="Collapsed"
                  AutomationProperties.Name="Open the full Markdown output in its default application"
                  Click="OnOpenFullOutputClick" />
            </InfoBar.ActionButton>
          </InfoBar>

          <TabView Grid.Row="2" IsAddTabButtonVisible="False" AutomationProperties.Name="Markdown result views">
            <TabViewItem Header="Rendered">
              <Grid>
                <WebView2 x:Name="PreviewWebView" AutomationProperties.Name="Rendered Markdown preview" />
              </Grid>
            </TabViewItem>
            <TabViewItem Header="Source">
              <TextBox
                  x:Name="SourceEditor"
                  Text="{Binding SourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  AcceptsReturn="True"
                  TextWrapping="NoWrap"
                  FontFamily="Consolas"
                  IsSpellCheckEnabled="False"
                  IsEnabled="False"
                  AutomationProperties.Name="Editable Markdown source"
                  TextChanged="OnSourceEditorTextChanged"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </TabViewItem>
          </TabView>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="3" RowDefinitions="Auto,Auto">
      <ProgressBar Grid.Row="0" Height="3" IsIndeterminate="{Binding IsBusy}" AutomationProperties.Name="Batch conversion progress" />
      <TextBlock Grid.Row="1" Padding="16,8" Text="{Binding ProgressText}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Conversion status" />
    </Grid>
  </Grid>
</Page>
