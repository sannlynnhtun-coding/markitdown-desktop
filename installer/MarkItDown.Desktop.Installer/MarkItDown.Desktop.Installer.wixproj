<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>MarkItDownDesktop-x64</OutputName>
    <AppVersion Condition="'$(AppVersion)' == ''">0.1.0</AppVersion>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\publish</PayloadDir>
    <DefineConstants>$(DefineConstants);AppVersion=$(AppVersion);PayloadDir=$(PayloadDir)</DefineConstants>
    <AcceptEula>wix7</AcceptEula>
    <!-- WinAppSDK multilingual PE metadata exceeds MSI's legacy Language column. -->
    <SuppressIces>ICE03</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>
</Project>
